# Copy this file to .env and fill in the values. .env is never committed.

# Required
SECRET_KEY=change-me-to-a-long-random-string
# 'dev' = SQLite + DEBUG on, 'prod' = MySQL + HTTPS-only secure cookies
SETTINGS=dev

# prod only
ALLOWED_HOSTS=ppis.ieeensusb.org
# set to 0 to turn off the HTTP->HTTPS redirect (for example behind a proxy that already does it)
SECURE_SSL_REDIRECT=1
PROD_DATABASE_NAME=
PROD_DATABASE_USER=
PROD_DATABASE_PASSWORD=
PROD_DATABASE_HOST=

# Gmail API (registration confirmation emails and QR emails)
DEV_GOOGLE_CLOUD_CLIENT_ID=
DEV_GOOGLE_CLOUD_PROJECT_ID=
DEV_GOOGLE_CLOUD_AUTH_URI=https://accounts.google.com/o/oauth2/auth
DEV_GOOGLE_CLOUD_TOKEN_URI=https://oauth2.googleapis.com/token
DEV_GOOGLE_CLOUD_AUTH_PROVIDER_x509_cert_url=https://www.googleapis.com/oauth2/v1/certs
DEV_GOOGLE_CLOUD_CLIENT_SECRET=
DEV_SCOPES=https://mail.google.com/
GOOGLE_MAIL_API_NAME=gmail
GOOGLE_MAIL_API_VERSION=v1

# Filled in automatically after you open /init/authorise/ as a superuser - leave empty
GOOGLE_CLOUD_TOKEN=
GOOGLE_CLOUD_REFRESH_TOKEN=
GOOGLE_CLOUD_EXPIRY=
